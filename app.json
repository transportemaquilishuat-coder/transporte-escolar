{
  "expo": {
    "name": "Transporte Escolar",
    "slug": "transporte-escolar",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permite que Transporte Escolar muestre tu ubicacion y calcule rutas durante el servicio.",
          "locationAlwaysPermission": "Permite rastrear la ruta en tiempo real incluso con la pantalla apagada.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "foregroundService": {
            "notificationTitle": "Ruta en curso",
            "notificationBody": "Compartiendo ubicación en tiempo real para seguridad de los alumnos.",
            "notificationColor": "#2196F3"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite seleccionar fotos para completar perfiles y registros.",
          "cameraPermission": "Permite tomar fotos para completar perfiles y registros."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "transporte"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "08dab61e-7094-4e59-80a5-6f7d69c45b0e"
      }
    },
    "android": {
      "package": "com.daniel7901.transporteescolar",
      "versionCode": 1,
      "showPerformanceRPC": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDVaVcUL_e_lO0nD29QUfOfl0u3RUUFEdM"
        }
      }
    },
    "ios": {
      "bundleIdentifier": "com.daniel7901.transporteescolar",
      "showPerformanceRPC": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch",
          "remote-notification"
        ]
      },
      "config": {
        "googleMapsApiKey": "AIzaSyDVaVcUL_e_lO0nD29QUfOfl0u3RUUFEdM"
      }
    }
  }
}
